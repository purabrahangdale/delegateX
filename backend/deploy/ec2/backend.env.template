# Template for /etc/delegatex/backend.env on the EC2 host (NOT committed with real values).
#   sudo install -d -m 750 -o root -g delegatex /etc/delegatex
#   sudo install -m 640 -o root -g delegatex backend.env.template /etc/delegatex/backend.env
#   sudo nano /etc/delegatex/backend.env    # fill in real values
#   sudo systemctl restart delegatex-backend  # env changes apply only after a restart
#
# Copy existing values from your current backend/.env / Render environment unchanged.
# systemd format: KEY=value, one per line, no `export`, no spaces around `=`.

DATABASE_URL=
EMAIL_USER=
EMAIL_PASS=
GEMINI_API_KEY=
N8N_WEBHOOK_BASE_URL=
WHATSAPP_SIMULATION_MODE=false

# --- Meta WhatsApp Cloud API ---
# Must equal the "Verify token" you type in Meta App Dashboard -> WhatsApp -> Configuration.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_URL=https://graph.facebook.com/v22.0
META_APP_ID=
# REQUIRED. Meta App Dashboard -> App settings -> Basic -> App secret. Without it every webhook POST gets 503.
META_APP_SECRET=
# Must be copied EXACTLY from the current environment: per-number tokens in MongoDB are encrypted with it.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Public HTTPS base URL of THIS backend (no trailing slash). Used for media URLs and the diagnostics page.
BACKEND_PUBLIC_URL=https://api.example.com
# Frontend origin(s) allowed by CORS, comma-separated.
FRONTEND_URL=

WHATSAPP_WEBHOOK_ALLOW_UNSIGNED=false
