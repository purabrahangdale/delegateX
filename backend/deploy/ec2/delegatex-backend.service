# systemd unit for the DelegateX FastAPI backend on EC2.
# Install: sudo cp delegatex-backend.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now delegatex-backend
#
# - Binds to 127.0.0.1 only; Nginx is the public entry point (HTTPS). Port 8000 must NOT be open in the security group.
# - Exactly one worker: the campaign send worker, schedulers and WebSocket connection registries are in-process.
# - Secrets come from /etc/delegatex/backend.env (root-owned, 0640). Do not keep a backend/.env on the server:
#   python-dotenv never overrides variables systemd already set, but a stale .env could fill in missing ones.

[Unit]
Description=DelegateX FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=delegatex
Group=delegatex
# Relative paths (static/, chroma_db/, knowledge_base/) resolve against the backend directory.
WorkingDirectory=/opt/delegatex/backend
EnvironmentFile=/etc/delegatex/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/delegatex/backend/venv/bin/uvicorn main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --no-server-header
Restart=always
RestartSec=5
TimeoutStopSec=30
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
